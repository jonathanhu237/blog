---
// TopBar.astro - 顶部导航栏组件
import { cn } from "@/lib/utils";
import TopBarButton from "./TopBarButton.astro";
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname;
---

<nav class="container flex mx-auto h-16 items-center justify-between px-4">
  <TopBarButton class="font-bold text-xl">
    <a href="/">Zezhao's Blog</a>
  </TopBarButton>

  <div class="flex items-center gap-2">
    <TopBarButton>
      <a href="/">Home</a>
    </TopBarButton>
    <TopBarButton>
      <a href="/about">About</a>
    </TopBarButton>
    <ThemeToggle />
  </div>
</nav>
