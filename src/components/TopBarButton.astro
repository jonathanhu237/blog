---
import { cn } from "@/lib/utils";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  class={cn(
    "cursor-pointer inline-flex items-center justify-center rounded-md py-2 px-4 hover:bg-foreground/10 transition-colors",
    className
  )}
>
  <slot />
</button>
